# =================================================================
# Streamlit Cloud secrets template (PLACEHOLDER — JANGAN ISI REAL!)
# =================================================================
# JANGAN commit file `secrets.toml` (yang asli) ke GitHub.
# File `.example` ini OK di-commit (semua value placeholder).
#
# Di Streamlit Community Cloud, paste isi file ini di:
#   Manage app -> Settings -> Secrets
# (sesuaikan value-nya dulu).
#
# Untuk dev lokal, file ini gak dipakai — pakai `.env` aja.
# =================================================================

# ----- Strava OAuth -----
# Dapat dari https://www.strava.com/settings/api
STRAVA_CLIENT_ID = "your_client_id_here"
STRAVA_CLIENT_SECRET = "your_client_secret_here"

# WAJIB diganti ke URL Streamlit Cloud Anda setelah deploy, contoh:
#   https://runcoach-ai-yourname.streamlit.app
# Trailing slash JANGAN ada.
STRAVA_REDIRECT_URI = "https://your-app-name.streamlit.app"

# ----- Default athlete profile (opsional, bisa di-override di Settings page) -----
ATHLETE_NAME = "Runner"
ATHLETE_AGE = "30"
ATHLETE_RESTING_HR = "60"
ATHLETE_MAX_HR = "190"
ATHLETE_FTHR = "170"
ATHLETE_THRESHOLD_PACE = "5.00"
