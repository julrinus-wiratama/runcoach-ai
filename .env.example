# ============================================
# RunCoach AI - Strava API Configuration
# ============================================
# Get these from https://www.strava.com/settings/api
# (Read README.md for step-by-step instructions)

STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
STRAVA_REDIRECT_URI=http://localhost:8501

# ============================================
# Athlete Profile (used for coach calculations)
# ============================================
# Edit these in the Settings page of the app,
# or pre-fill here. Leave defaults if unsure.

ATHLETE_NAME=Runner
ATHLETE_AGE=30
ATHLETE_RESTING_HR=60
ATHLETE_MAX_HR=190
ATHLETE_FTHR=170             # Functional Threshold HR (lactate threshold HR)
ATHLETE_THRESHOLD_PACE=5.00  # Threshold pace in min/km (e.g. 5.00 = 5:00/km)
